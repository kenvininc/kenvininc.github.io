# Copy to .env and edit. Do not commit .env.

# Login password for the web app (required, use something long)
APP_PASSWORD=change-me-to-a-long-password

# Absolute path of the music folder on the NAS (Synology example: /volume1/music)
MUSIC_PATH=/volume1/music

# UID/GID that can read/write MUSIC_PATH
PUID=1000
PGID=1000

# Host port the container is published on
HOST_PORT=8095

# Max size per uploaded file (MB)
MAX_UPLOAD_MB=500

# Uploaded files go to MUSIC_PATH/<UPLOAD_SUBDIR>
UPLOAD_SUBDIR=Uploads

# Login cookie lifetime in days
SESSION_DAYS=180

# Rescan the music folder every N minutes (0 = only at startup + manual "Quét lại")
RESCAN_MINUTES=60
