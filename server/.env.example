# Bắt buộc nếu PUBLIC_MODE=0. Tạo chuỗi random, ví dụ: openssl rand -hex 24
API_KEY=change-me

# Chỉ cần khi gọi API từ web ở domain khác (cách nhau bằng dấu phẩy).
# Web serve tại https://dl.kenvin.biz/ thì để trống.
ALLOWED_ORIGINS=

MAX_FILESIZE_MB=500
MAX_CONCURRENT=2
DOWNLOAD_TIMEOUT=300
YTDLP_AUTO_UPDATE=1

# Public mode: ai cũng dùng được không cần key.
# Người có API key đúng vẫn không bị giới hạn và được dùng cookies.
PUBLIC_MODE=0
PUBLIC_RATE_LIMIT=10
PUBLIC_MAX_FILESIZE_MB=200
