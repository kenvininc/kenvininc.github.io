# Sao chép thành .env rồi sửa. KHÔNG commit file .env.

# Chuỗi ngẫu nhiên dài, ví dụ: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=thay-bang-chuoi-ngau-nhien

DEBUG=0
# Domain của shop, cách nhau bằng dấu phẩy. Thêm IP NAS nếu muốn test trong LAN.
ALLOWED_HOSTS=shop.example.com
CSRF_TRUSTED_ORIGINS=https://shop.example.com
SITE_URL=https://shop.example.com

# Database (container db dùng chính các giá trị này để khởi tạo)
POSTGRES_DB=kenvinshop
POSTGRES_USER=kenvinshop
POSTGRES_PASSWORD=thay-bang-mat-khau-manh

# Cookie chỉ gửi qua HTTPS. Đặt 0 TẠM THỜI nếu test qua http://IP-NAS:8687 trong LAN.
SECURE_COOKIES=1
# 1 khi chạy sau reverse proxy HTTPS (nginx 192.168.1.48 / Cloudflare) có gửi X-Forwarded-Proto.
TRUST_X_FORWARDED_PROTO=1
# HSTS (giây). Để 0 cho tới khi HTTPS chạy ổn định; sau đó có thể đặt 31536000.
SECURE_HSTS_SECONDS=0
# Số proxy đứng trước Django để lấy IP thật của khách (xem DEPLOY.md mục IP khách).
NUM_PROXIES=1

# Port trên NAS
HTTP_PORT=8687
GUNICORN_WORKERS=3

# Email (tùy chọn). Để trống EMAIL_HOST = không gửi email.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=
# Email nhận thông báo đơn mới, cách nhau bằng dấu phẩy
ORDER_NOTIFY_EMAILS=

LOG_LEVEL=INFO
